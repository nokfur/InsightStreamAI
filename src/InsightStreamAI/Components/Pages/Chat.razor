@page "/chat"
@using InsightStreamAI.Domain.Entities
@using InsightStreamAI.Application.Services
@using InsightStreamAI.Application.Repositories
@using InsightStreamAI.Application.Common
@using InsightStreamAI.Application.Models
@using System.Text
@using Markdig
@inject ISemanticKernelService SKService
@inject IChatRepository ChatRepository
@inject ICitationTracker CitationTracker
@inject IJSRuntime JSRuntime

<PageTitle>InsightStream AI - Agent Chat</PageTitle>

<div class="chat-layout animate-fade">
    <!-- Overlay backdrop for mobile when sidebar is open -->
    <div class="chat-overlay @(isSidebarVisible ? "visible" : "")" @onclick="ToggleSidebar"></div>

    <!-- Conversation Sidebar -->
    <div class="chat-sidebar glass-card @(isSidebarVisible ? "sidebar-visible" : "sidebar-hidden")">
        <button class="btn-premium w-100 mb-3" @onclick="CreateNewConversation" disabled="@isSending">
            <span>+</span> New Chat
        </button>

        <div class="conversation-list">
            @if (conversations == null)
            {
                <p class="text-muted text-center mt-3">Loading chats...</p>
            }
            else if (conversations.Count == 0)
            {
                <p class="text-muted text-center mt-3">No past chats</p>
            }
            else
            {
                @foreach (var conv in conversations)

                {
                    <div class="conversation-item @(selectedConversation?.Id == conv.Id ? "active" : "")"
                        @onclick="() => SelectConversation(conv)">
                        <span class="chat-icon">💬</span>
                        <span class="chat-title" title="@conv.Title">@conv.Title</span>
                        <button class="btn-delete-chat" @onclick:stopPropagation="true"
                            @onclick="() => DeleteConversation(conv.Id)">×</button>
                    </div>
                }
            }
        </div>
    </div>

    <!-- Active Chat Window -->
    <div class="chat-window glass-card">
        @if (selectedConversation == null)

        {
            <div class="empty-chat-state">
                <button class="btn-toggle-sidebar btn-toggle-sidebar-empty btn-premium" @onclick="ToggleSidebar"
                    title="Toggle conversations">☰ Conversations</button>
                <span class="glow-symbol">✦</span>
                <h2>InsightStream AI Agent</h2>
                <p class="text-muted">Select an existing conversation or start a new one to query your indexed documents.
                </p>
                <button class="btn-premium mt-3" @onclick="CreateNewConversation">Start New Chat</button>
            </div>
        }

        else

        {
            <div class="chat-header">
                <div class="chat-header-info">
                    <div class="chat-header-title-container">
                        <button class="btn-toggle-sidebar" @onclick="ToggleSidebar" title="Toggle conversations">☰</button>
                        <h3>@selectedConversation.Title</h3>
                    </div>
                    <span class="chat-status text-muted">Connected to local knowledge library</span>
                </div>
            </div>

            <div class="chat-messages" id="chatMessages">
                @foreach (var msg in messages)

                {

                    bool isError = !msg.Role.Equals("user", StringComparison.OrdinalIgnoreCase) &&

                    (msg.Content.StartsWith("Error during streaming response:") || msg.Content.StartsWith("Failed to"));
                    <div
                        class="message @(msg.Role.Equals("user", StringComparison.OrdinalIgnoreCase) ? "message-user" : "message-assistant") @(isError ? "message-error" : "")">
                        <div class="message-header-row">
                            <div class="message-sender">@(msg.Role.Equals("user", StringComparison.OrdinalIgnoreCase) ? "You" :
                        "InsightStream")</div>
                            <button class="btn-copy-message" @onclick="() => CopyMessage(msg.Id, msg.Content)" title="Copy message text">
                                @(copiedMessageId == msg.Id ? "✔" : "📋")
                            </button>
                        </div>
                        <div class="message-content">
                            @((MarkupString)FormatMarkdown(msg.Content))
                        </div>
                        @if (!msg.Role.Equals("user", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrEmpty(msg.CitationsJson))
                        {
                            var citations = GetCitationsList(msg.CitationsJson);
                            @if (citations != null && citations.Count > 0)
                            {
                                <div class="citations-container">
                                    <div class="citations-header">Sources Used:</div>
                                    <div class="citations-list">
                                        @foreach (var citation in citations)
                                        {
                                            var pageLabel = citation.PageNumber.HasValue ? $" (Page {citation.PageNumber.Value})" : string.Empty;
                                            var badgeId = $"cit-{msg.Id}-{citations.IndexOf(citation)}";
                                            <div class="citation-wrapper">
                                                <button class="citation-badge" @onclick="() => ToggleCitation(badgeId)">
                                                    📄 @citation.DocumentTitle@pageLabel <span class="citation-score">@((citation.Score * 100).ToString("N0"))% Match</span>
                                                </button>
                                                <div id="@badgeId" class="citation-details" style="display: @(activeCitations.Contains(badgeId) ? "block" : "none")">
                                                    <div class="citation-text">@citation.TextExcerpt</div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }

                @if (isSending && currentAssistantChunk.Length > 0)

                {
                    <div class="message message-assistant streaming-cursor">
                        <div class="message-sender">InsightStream</div>
                        <div class="message-content">
                            @((MarkupString)FormatMarkdown(currentAssistantChunk.ToString()))
                        </div>
                    </div>
                }

                else if (isSending && currentAssistantChunk.Length == 0)

                {
                    <div class="message message-assistant thinking-loader">
                        <div class="message-sender">InsightStream</div>
                        <div class="message-content">
                            <span class="dot">.</span><span class="dot">.</span><span class="dot">.</span>
                        </div>
                    </div>
                }
            </div>

            <div class="chat-input-area">
                <textarea @bind="userPrompt" @bind:event="oninput" @onkeydown="OnKeyDown"
                    placeholder="Type a message or query... (Press Enter to Send)" disabled="@isSending"
                    class="chat-textarea" rows="2"></textarea>
                @if (isSending)
                {
                    <button class="btn-stop-response" @onclick="StopResponding">
                        ⏹ Stop
                    </button>
                }
                else
                {
                    <button class="btn-premium" @onclick="SendMessage"
                        disabled="@(string.IsNullOrWhiteSpace(userPrompt))">
                        Send
                    </button>
                }
            </div>
        }
    </div>
</div>

<style>
    .chat-layout {
        display: flex;
        gap: 1.5rem;
        height: calc(100vh - 4.5rem);
        padding-bottom: 0.5rem;
        position: relative;
    }

    .chat-sidebar {
        width: 280px;
        display: flex;
        flex-direction: column;
        padding: 1.25rem;
        flex-shrink: 0;
        background: var(--bg-sidebar);
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .conversation-list {
        flex: 1;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .conversation-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0.75rem;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s ease;
        position: relative;
        border: 1px solid transparent;
        color: var(--text-muted);
    }

    .conversation-item:hover {
        background: rgba(255, 255, 255, 0.03);
        color: #ffffff;
    }

    .conversation-item.active {
        background: rgba(0, 242, 254, 0.05);
        border-color: rgba(0, 242, 254, 0.15);
        color: var(--primary);
    }

    .chat-title {
        font-size: 0.9rem;
        font-weight: 500;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        flex: 1;
        padding-right: 1.5rem;
    }

    .btn-delete-chat {
        position: absolute;
        right: 0.5rem;
        background: transparent;
        border: none;
        color: var(--text-muted);
        font-size: 1.25rem;
        cursor: pointer;
        opacity: 0;
        transition: opacity 0.2s ease, color 0.2s ease;
        line-height: 1;
    }

    .conversation-item:hover .btn-delete-chat {
        opacity: 1;
    }

    .btn-delete-chat:hover {
        color: #ef4444;
    }

    .chat-window {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .empty-chat-state {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 2rem;
        position: relative;
    }

    .glow-symbol {
        font-size: 3.5rem;
        color: var(--primary);
        text-shadow: 0 0 15px var(--primary);
        margin-bottom: 1.5rem;
    }

    .chat-header {
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--border-color);
        background: rgba(255, 255, 255, 0.01);
    }

    .chat-header-title-container {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .chat-header h3 {
        margin: 0;
        font-size: 1.15rem;
    }

    .chat-status {
        font-size: 0.8rem;
        display: block;
        margin-top: 0.25rem;
    }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        background: rgba(0, 0, 0, 0.05);
    }

    .message-sender {
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        opacity: 0.75;
        margin-bottom: 0.35rem;
        font-weight: 600;
    }

    .chat-input-area {
        padding: 1.25rem 1.5rem;
        border-top: 1px solid var(--border-color);
        display: flex;
        gap: 1rem;
        align-items: flex-end;
        background: rgba(255, 255, 255, 0.01);
    }

    .chat-textarea {
        flex: 1;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 0.75rem 1rem;
        color: #ffffff;
        font-family: var(--font-body);
        font-size: 0.95rem;
        resize: none;
        transition: all 0.2s ease;
    }

    .chat-textarea:focus {
        outline: none;
        border-color: var(--primary);
        background: rgba(255, 255, 255, 0.06);
        box-shadow: 0 0 10px rgba(0, 242, 254, 0.1);
    }

    .inline-code {
        background: rgba(255, 255, 255, 0.1);
        padding: 0.15rem 0.35rem;
        border-radius: 4px;
        font-family: monospace;
        font-size: 0.85rem;
        color: var(--primary);
    }

    .code-block {
        background: rgba(0, 0, 0, 0.3);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 0.75rem 1rem;
        font-family: monospace;
        font-size: 0.85rem;
        overflow-x: auto;
        color: #e2e8f0;
        margin: 0.5rem 0;
    }

    /* Thinking indicator dots */
    .thinking-loader .dot {
        font-size: 1.5rem;
        line-height: 0.5;
        animation: wave 1.2s infinite;
        display: inline-block;
    }

    .thinking-loader .dot:nth-child(2) {
        animation-delay: 0.2s;
    }

    .thinking-loader .dot:nth-child(3) {
        animation-delay: 0.4s;
    }

    /* Warning/Error messages style */
    .message-error {
        border-color: rgba(239, 68, 68, 0.3) !important;
        background: rgba(239, 68, 68, 0.08) !important;
        color: #f87171 !important;
        box-shadow: 0 4px 15px rgba(239, 68, 68, 0.1) !important;
    }

    .message-error .message-sender {
        color: #ef4444 !important;
    }

    /* Mobile Sidebar & Toggle Controls */
    .btn-toggle-sidebar {
        display: none;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--border-color);
        color: var(--text-main);
        width: 2.25rem;
        height: 2.25rem;
        border-radius: 8px;
        cursor: pointer;
        font-size: 1.1rem;
        transition: all 0.2s ease;
    }

    .btn-toggle-sidebar:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.2);
    }

    .btn-toggle-sidebar-empty {
        position: absolute;
        top: 1rem;
        left: 1rem;
        display: none;
        padding: 0.5rem 1rem;
        width: auto;
        height: auto;
    }

    .chat-overlay {
        display: none;
    }

    @@keyframes wave {

        0%,
        100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-5px);
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fade {
        animation: fadeIn 0.4s ease-out forwards;
    }

    .w-100 {
        width: 100%;
    }

    .mb-3 {
        margin-bottom: 1rem;
    }

    .mt-3 {
        margin-top: 1rem;
    }

    .citations-container {
        margin-top: 0.75rem;
        padding-top: 0.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        text-align: left;
    }

    .citations-header {
        font-size: 0.75rem;
        text-transform: uppercase;
        color: var(--text-muted);
        letter-spacing: 0.05em;
        font-weight: 700;
        margin-bottom: 0.4rem;
    }

    .citations-list {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .citation-wrapper {
        display: flex;
        flex-direction: column;
        width: 100%;
    }

    .citation-badge {
        align-self: flex-start;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--border-color);
        color: var(--text-main);
        padding: 0.35rem 0.65rem;
        border-radius: 8px;
        font-size: 0.8rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s ease;
        font-weight: 500;
        text-align: left;
    }

    .citation-badge:hover {
        background: rgba(0, 242, 254, 0.08);
        border-color: rgba(0, 242, 254, 0.3);
        color: var(--primary);
    }

    .citation-score {
        background: rgba(0, 242, 254, 0.10);
        color: var(--primary);
        padding: 0.05rem 0.3rem;
        border-radius: 4px;
        font-size: 0.7rem;
        font-weight: 600;
    }

    .citation-details {
        background: rgba(0, 0, 0, 0.25);
        border-left: 2px solid var(--primary);
        margin-top: 0.35rem;
        padding: 0.6rem 0.8rem;
        border-radius: 6px;
        animation: fadeIn 0.25s ease-out;
    }

    .citation-text {
        font-size: 0.8rem;
        color: var(--text-muted);
        line-height: 1.45;
        font-style: italic;
    }

    .message-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.35rem;
    }

    .btn-copy-message {
        background: transparent;
        border: none;
        color: var(--text-muted);
        font-size: 0.85rem;
        cursor: pointer;
        padding: 0.1rem 0.3rem;
        border-radius: 4px;
        opacity: 0;
        transition: opacity 0.2s ease, color 0.2s ease, background 0.2s ease;
    }

    .message:hover .btn-copy-message {
        opacity: 0.8;
    }

    .btn-copy-message:hover {
        color: var(--primary);
        background: rgba(255, 255, 255, 0.04);
        opacity: 1 !important;
    }

    .btn-stop-response {
        font-family: var(--font-heading);
        font-weight: 600;
        font-size: 0.9rem;
        letter-spacing: 0.03em;
        padding: 0.6rem 1.4rem;
        border-radius: 10px;
        border: 1px solid rgba(239, 68, 68, 0.4);
        color: #ef4444;
        background: rgba(239, 68, 68, 0.08);
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(239, 68, 68, 0.15);
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
    }

    .btn-stop-response:hover {
        background: #ef4444;
        color: #ffffff;
        border-color: #ef4444;
        box-shadow: 0 6px 16px rgba(239, 68, 68, 0.35);
        transform: translateY(-1px);
    }

    .btn-stop-response:active {
        transform: translateY(1px);
    }

    /* Media query for mobile layouts */
    @@media (max-width: 768px) {
        .btn-toggle-sidebar {
            display: inline-flex;
        }

        .btn-toggle-sidebar-empty {
            display: inline-flex;
        }

        .chat-sidebar {
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            z-index: 100;
            width: 280px;
            box-shadow: 5px 0 25px rgba(0, 0, 0, 0.6);
        }

        .chat-sidebar.sidebar-hidden {
            transform: translateX(-105%);
        }

        .chat-sidebar.sidebar-visible {
            transform: translateX(0);
        }

        .chat-overlay.visible {
            display: block;
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.55);
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
            z-index: 99;
        }
    }
</style>

@code {
    private CancellationTokenSource? cts;
    private List<ChatConversation>? conversations = null;

    private ChatConversation? selectedConversation = null;

    private List<ChatMessage> messages = new();

    private string userPrompt = string.Empty;

    private bool isSending = false;

    private StringBuilder currentAssistantChunk = new();

    private bool isSidebarVisible = false;



    private void ToggleSidebar()

    {

        isSidebarVisible = !isSidebarVisible;

    }



    protected override async Task OnInitializedAsync()

    {

        await LoadConversations();

    }



    private async Task LoadConversations()

    {

        conversations = await ChatRepository.GetAllConversationsAsync();

    }



    private async Task CreateNewConversation()

    {

        var conversation = new ChatConversation

            {

                Title = $"{Constants.Prompts.DefaultTitlePrefix} {DateTime.Now:MM/dd HH:mm}"

            };

        await ChatRepository.AddConversationAsync(conversation);



        await LoadConversations();

        await SelectConversation(conversation);

        isSidebarVisible = false;

    }



    private async Task SelectConversation(ChatConversation conversation)

    {

        selectedConversation = conversation;

        messages = await ChatRepository.GetMessagesByConversationIdAsync(conversation.Id);



        currentAssistantChunk.Clear();

        isSidebarVisible = false;

        StateHasChanged();

        await Task.Delay(10);

        await ScrollToBottom();

    }



    private async Task DeleteConversation(Guid id)

    {

        await ChatRepository.DeleteConversationAsync(id);



        if (selectedConversation?.Id == id)

        {

            selectedConversation = null;

            messages.Clear();

        }



        await LoadConversations();

    }



    private async Task SendMessage()

    {

        if (string.IsNullOrWhiteSpace(userPrompt) || selectedConversation == null || isSending)

        {

            return;

        }



        var prompt = userPrompt.Trim();

        userPrompt = string.Empty;

        isSending = true;

        currentAssistantChunk.Clear();

        CitationTracker.Clear();

        StateHasChanged();



        // 1. Create and save user message

        var userMessage = new ChatMessage

            {

                ConversationId = selectedConversation.Id,

                Role = "user",

                Content = prompt,

                CreatedAt = DateTime.UtcNow

            };

        await ChatRepository.AddMessageAsync(userMessage);

        messages.Add(userMessage);



        // Update conversation title if it was default

        if (selectedConversation.Title.StartsWith(Constants.Prompts.DefaultTitlePrefix))

        {

            selectedConversation.Title = prompt.Length > 25 ? prompt.Substring(0, 25) + "..." : prompt;

            await ChatRepository.UpdateConversationTitleAsync(selectedConversation.Id, selectedConversation.Title);

        }



        StateHasChanged();

        await ScrollToBottom();



        // 2. Fetch stream from SemanticKernelService

        cts = new CancellationTokenSource();

        try

        {

            var stream = SKService.GetStreamingResponseAsync(messages, prompt, cts.Token);



            await foreach (var chunk in stream.WithCancellation(cts.Token))

            {

                currentAssistantChunk.Append(chunk);

                StateHasChanged();

                await ScrollToBottom();

            }

        }

        catch (OperationCanceledException)

        {

            // Gracefully handled user cancellation

        }

        catch (Exception ex)

        {

            var errorMessage = $"Error during streaming response: {ex.Message}";

            var errorMsgObj = new ChatMessage

                {

                    ConversationId = selectedConversation.Id,

                    Role = "assistant",

                    Content = errorMessage,

                    CreatedAt = DateTime.UtcNow

                };

            await ChatRepository.AddMessageAsync(errorMsgObj);

            messages.Add(errorMsgObj);

        }

        finally

        {

            // 3. Save assistant response to DB (saves full or partial text before cancellation)

            var assistantResponse = currentAssistantChunk.ToString();

            if (!string.IsNullOrEmpty(assistantResponse) && !assistantResponse.StartsWith("Error during streaming response:"))

            {

                var citations = CitationTracker.GetCitations();

                var citationsJson = citations.Count > 0 ? System.Text.Json.JsonSerializer.Serialize(citations) : null;



                var assistantMessage = new ChatMessage

                    {

                        ConversationId = selectedConversation.Id,

                        Role = "assistant",

                        Content = assistantResponse,

                        CitationsJson = citationsJson,

                        CreatedAt = DateTime.UtcNow

                    };

                await ChatRepository.AddMessageAsync(assistantMessage);

                messages.Add(assistantMessage);

            }



            isSending = false;

            currentAssistantChunk.Clear();

            cts?.Dispose();

            cts = null;

            StateHasChanged();

            await ScrollToBottom();

            await LoadConversations(); // Refresh titles

        }

    }



    private async Task OnKeyDown(KeyboardEventArgs e)

    {

        if (e.Key == "Enter" && !e.ShiftKey)

        {

            await SendMessage();

        }

    }



    private async Task ScrollToBottom()

    {

        try

        {

            await JSRuntime.InvokeVoidAsync("scrollToBottom", "chatMessages");

        }

        catch { }

    }



    private string FormatMarkdown(string text)

    {

        if (string.IsNullOrEmpty(text)) return string.Empty;



        // Render Markdown safely using Markdig with DisableHtml to prevent XSS

        var pipeline = new MarkdownPipelineBuilder()

        .UseAdvancedExtensions()

        .DisableHtml()

        .Build();



        return Markdown.ToHtml(text, pipeline);

    }

    private HashSet<string> activeCitations = new();

    private void ToggleCitation(string citationId)
    {
        if (activeCitations.Contains(citationId))
        {
            activeCitations.Remove(citationId);
        }
        else
        {
            activeCitations.Add(citationId);
        }
        StateHasChanged();
    }

    private List<ChatMessageCitation>? GetCitationsList(string citationsJson)
    {
        try
        {
            return System.Text.Json.JsonSerializer.Deserialize<List<ChatMessageCitation>>(citationsJson);
        }
        catch
        {
            return null;
        }
    }

    private Guid? copiedMessageId = null;

    private async Task CopyMessage(Guid messageId, string content)
    {
        var success = await JSRuntime.InvokeAsync<bool>("copyToClipboard", content);
        if (success)
        {
            copiedMessageId = messageId;
            StateHasChanged();
            await Task.Delay(2000);
            if (copiedMessageId == messageId)
            {
                copiedMessageId = null;
                StateHasChanged();
            }
        }
    }

    private void StopResponding()
    {
        cts?.Cancel();
    }
}
