@page "/documents"
@using InsightStreamAI.Domain.Entities
@using InsightStreamAI.Application.Services
@inject IDocumentService DocumentService

<PageTitle>InsightStream AI - Document Hub</PageTitle>

<div class="documents-container">
    <div class="header animate-fade">
        <h1 class="gradient-title">Document Hub</h1>
        <p class="subtitle">Upload text files to populate your AI agent's semantic knowledge base.</p>
    </div>

    <div class="upload-section animate-fade">
        <div class="glass-card p-4">
            <h3>Upload New Document</h3>
            <p class="text-muted">Currently supports plain text files (.txt, .md, .csv, .json). Maximum size: 2MB.</p>
            
            <div class="mt-4">
                <label class="drag-drop-zone">
                    <i>📁</i>
                    @if (isUploading)
                    {
                        <div class="spinner-border" role="status"></div>
                        <span class="upload-status mt-2">Segmentizing & Generating Vector Embeddings...</span>
                    }
                    else
                    {
                        <span class="upload-title">Click to browse or drag text file here</span>
                        <span class="text-muted text-xs">Supported: .txt, .md, .json, .csv</span>
                    }
                    <InputFile OnChange="OnFileChange" disabled="@isUploading" class="hidden-file-input" />
                </label>
            </div>
            
            @if (uploadError != null)
            {
                <div class="error-banner mt-3">
                    ⚠️ @uploadError
                </div>
            }
        </div>
    </div>

    <div class="library-section mt-4 animate-fade">
        <h2 class="section-title">Knowledge Library</h2>
        
        @if (documents == null)
        {
            <div class="loading-state">
                <div class="spinner-border" role="status"></div>
                <p class="text-muted mt-2">Loading library...</p>
            </div>
        }
        else if (documents.Count == 0)
        {
            <div class="glass-card empty-state">
                <div class="empty-icon">🗂</div>
                <h3>Your library is empty</h3>
                <p class="text-muted">Upload text files above. Your local AI agent will use them to answer questions during chats.</p>
            </div>
        }
        else
        {
            <div class="table-container glass-card">
                <table class="library-table">
                    <thead>
                        <tr>
                            <th>Document Title</th>
                            <th>File Size</th>
                            <th>Segments</th>
                            <th>Indexed On</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in documents)
                        {
                            <tr>
                                <td class="doc-title-cell">
                                    <span class="doc-icon">📄</span>
                                    <span class="doc-title-text" title="@doc.Title">@doc.Title</span>
                                </td>
                                <td>@FormatFileSize(doc.FileSize)</td>
                                <td>
                                    <span class="badge-chunks">@doc.Chunks.Count chunks</span>
                                </td>
                                <td>@doc.CreatedAt.ToLocalTime().ToString("g")</td>
                                <td class="text-right">
                                    <button class="btn-delete" @onclick="() => DeleteDoc(doc.Id)">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<style>
    .gradient-title {
        font-size: 2.25rem;
        background: linear-gradient(to right, #ffffff, #00f2fe);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 0.25rem;
    }
    
    .subtitle {
        color: var(--text-muted);
        font-size: 1rem;
        margin-bottom: 1.25rem;
    }
    
    .hidden-file-input {
        display: none;
    }
    
    .drag-drop-zone {
        padding: 1.5rem 1.5rem;
    }
    
    .upload-status {
        color: var(--primary);
        font-weight: 500;
        animation: pulse 1.5s infinite;
    }
    
    .error-banner {
        background: rgba(229, 0, 0, 0.1);
        border: 1px solid rgba(229, 0, 0, 0.3);
        color: #ff8888;
        padding: 0.75rem 1rem;
        border-radius: 8px;
        font-size: 0.9rem;
    }
    
    .section-title {
        font-size: 1.5rem;
        margin-bottom: 0.75rem;
    }
    
    .loading-state, .empty-state {
        text-align: center;
        padding: 2rem 1.5rem;
    }
    
    .empty-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
        opacity: 0.5;
    }
    
    .table-container {
        overflow-x: auto;
        border-radius: 16px;
    }
    
    .library-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
        font-size: 0.95rem;
    }
    
    .library-table th, .library-table td {
        padding: 0.75rem 1.25rem;
        border-bottom: 1px solid var(--border-color);
    }
    
    .library-table th {
        font-family: var(--font-heading);
        font-weight: 600;
        color: var(--text-muted);
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        background: rgba(255, 255, 255, 0.02);
    }
    
    .library-table tr:last-child td {
        border-bottom: none;
    }
    
    .doc-title-cell {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 500;
    }

    .doc-title-text {
        max-width: 250px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        display: inline-block;
    }
    
    .doc-icon {
        font-size: 1.1rem;
    }
    
    .badge-chunks {
        background: rgba(0, 242, 254, 0.1);
        border: 1px solid rgba(0, 242, 254, 0.2);
        color: var(--primary);
        padding: 0.2rem 0.5rem;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 600;
    }
    
    .btn-delete {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.2);
        color: #ef4444;
        padding: 0.35rem 0.75rem;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.85rem;
        font-weight: 500;
        transition: all 0.2s ease;
    }
    
    .btn-delete:hover {
        background: #ef4444;
        color: #ffffff;
        border-color: #ef4444;
    }
    
    .text-right {
        text-align: right;
    }
    
    .text-xs {
        font-size: 0.75rem;
    }
    
    .mt-2 { margin-top: 0.5rem; }
    .mt-3 { margin-top: 0.75rem; }
    .mt-4 { margin-top: 1rem; }
    .mt-5 { margin-top: 1.5rem; }

    .spinner-border {
        display: inline-block;
        width: 2rem;
        height: 2rem;
        vertical-align: text-bottom;
        border: .25em solid currentColor;
        border-right-color: transparent;
        border-radius: 50%;
        color: var(--primary);
        animation: spinner-border .75s linear infinite;
    }

    .animate-fade {
        animation: fadeIn 0.4s ease-out forwards;
    }
</style>

@code {
    private List<Document>? documents = null;
    private bool isUploading = false;
    private string? uploadError = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadDocuments();
    }

    private async Task LoadDocuments()
    {
        documents = await DocumentService.GetDocumentsAsync();
    }

    private async Task OnFileChange(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            isUploading = true;
            uploadError = null;
            StateHasChanged();

            try
            {
                // Limit to 2MB text files
                using var stream = file.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
                using var reader = new StreamReader(stream);
                var content = await reader.ReadToEndAsync();

                if (string.IsNullOrWhiteSpace(content))
                {
                    throw new Exception("File is empty.");
                }

                await DocumentService.IndexDocumentAsync(file.Name, content, file.Size);
                await LoadDocuments();
            }
            catch (Exception ex)
            {
                uploadError = $"Failed to index file: {ex.Message}";
            }
            finally
            {
                isUploading = false;
                StateHasChanged();
            }
        }
    }

    private async Task DeleteDoc(Guid id)
    {
        try
        {
            await DocumentService.DeleteDocumentAsync(id);
            await LoadDocuments();
        }
        catch (Exception ex)
        {
            uploadError = $"Failed to delete document: {ex.Message}";
        }
    }

    private string FormatFileSize(long bytes)
    {
        string[] suffixes = { "B", "KB", "MB" };
        int counter = 0;
        decimal number = bytes;
        while (Math.Round(number / 1024) >= 1)
        {
            number /= 1024;
            counter++;
        }
        return $"{number:n1} {suffixes[counter]}";
    }
}
